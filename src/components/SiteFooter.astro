---
import { site } from '../data/site';
---

<footer data-inverse style="background: var(--ink-1); color: var(--paper-1); border-top: var(--rule-structural) solid var(--ink-1)">
  <div style="max-width: 1440px; margin: 0 auto; padding: 20px var(--frame-margin); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 32px; font: var(--text-label); letter-spacing: var(--tracking-label); text-transform: uppercase">
    <span>© Standard Inference</span>
    <span style="display: flex; flex-wrap: wrap; gap: 12px 32px; align-items: center">
      <span style="text-transform: none; letter-spacing: 0.02em">{site.email}</span>
      <a href="/#how-we-check" style="color: var(--paper-0); min-height: 44px; display: inline-flex; align-items: center">Corrections →</a>
    </span>
  </div>
</footer>
