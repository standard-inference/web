---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Standard Inference">
  <div style="display: grid; gap: 16px; padding: 48px 0">
    <span class="label" style="color: var(--ink-2)">Error 404</span>
    <h1 style="margin: 0; font: var(--weight-bold) var(--type-display)/var(--lh-tight) var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-display)">Page not found</h1>
    <p style="margin: 0; max-width: 56ch; font: var(--weight-regular) var(--type-body-l)/1.45 var(--font-body); color: var(--ink-2)">That page doesn’t exist. <a href="/">Back to the home page →</a></p>
  </div>
</Base>
