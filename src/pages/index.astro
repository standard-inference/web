---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroActions from '../components/react/HeroActions.jsx';
import ResponsiveStamp from '../components/react/ResponsiveStamp.jsx';
import Channel from '../components/react/Channel.jsx';
import { Panel } from '../ds/index.js';
import { series, site } from '../data/site';

const episodes = (await getCollection('episodes')).sort((a, b) => a.data.n - b.data.n);
const ep1 = episodes[0];
const episodeList = episodes.map((e) => ({ n: e.data.n, code: e.data.code, series: e.data.series, title: e.data.title, question: e.data.question, href: `/episodes/${e.id}/` }));
const notes = (await getCollection('notes')).sort((a, b) => b.data.code.localeCompare(a.data.code));
const episodeFor = (code: string) => episodes.find((e) => e.data.code === code);
const softmax = notes.find((n) => n.data.episode === 'D1');
---

<Base title="Standard Inference — AI, explained plainly" description="Calm, clear videos on how AI actually works, for people who don’t work in tech." wide>
  <section aria-labelledby="hero-title" style="max-width: 1440px; margin: 0 auto; padding: clamp(32px,5vw,72px) var(--frame-margin) 96px; display: grid; gap: 40px">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 48px clamp(32px,5vw,80px); align-items: center">
      <div style="display: grid; gap: 24px">
        <h1 id="hero-title" style="margin: 0; font: var(--weight-bold) var(--type-display-xl)/var(--lh-tight) var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-display)">Standard<br />Inference</h1>
        <p style="margin: 0; font: var(--weight-bold) var(--type-h2)/var(--lh-heading) var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-header); color: var(--ink-2)">AI, explained plainly.</p>
        <p style="margin: 0; max-width: 34ch; font: var(--weight-regular) var(--type-body-l)/var(--lh-body) var(--font-body); color: var(--ink-1); text-wrap: pretty">Calm, clear videos on how AI actually works, for people who don’t work in tech.</p>
        <HeroActions client:load watchHref={`/episodes/${ep1.id}/`} youtube={site.youtube} />
      </div>
      <a data-press href={`/episodes/${ep1.id}/`} aria-label={`Watch episode one: ${ep1.data.title}`} style="display: grid; border: var(--rule-structural) solid var(--ink-1); background: var(--paper-0); box-shadow: var(--shadow-print); color: var(--ink-1); text-decoration: none">
        <div style="aspect-ratio: 16 / 9; background: var(--ink-1); color: var(--paper-1); display: grid; place-items: center; border-bottom: var(--rule-structural) solid var(--ink-1)">
          <div style="display: grid; justify-items: center; gap: 16px; text-align: center; padding: 16px">
            <span style="width: clamp(56px,6vw,88px); aspect-ratio: 1; background: var(--signal-500); color: var(--ink-1); border: var(--rule-structural) solid var(--paper-1); display: grid; place-items: center; font: 600 clamp(24px,2.6vw,36px)/1 var(--font-mono)">▶</span>
            <span class="label">Thumbnail // {ep1.data.code} // 16:9</span>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: stretch">
          <span style="display: flex; align-items: center; padding: 0 18px; border-right: var(--rule-structural) solid var(--ink-1); font: var(--weight-bold) var(--type-h2)/1 var(--font-display)">01</span>
          <span style="display: grid; gap: 6px; padding: 16px 20px">
            <span class="label" style="color: var(--ink-3)">Start here // {ep1.data.series}</span>
            <span class="h3-caps">{ep1.data.title}</span>
            <span style="font: var(--text-body); color: var(--ink-2)">Answers: “{ep1.data.question}”</span>
          </span>
        </div>
      </a>
    </div>
  </section>

  <Channel client:load episodes={episodeList} series={series} youtube={site.youtube} softmaxHref={softmax ? `/notes/${softmax.id}/` : '/notes/'} />

  <section id="notes" aria-labelledby="h-notes" data-wipe class="section">
    <div class="section-head" style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 32px">
      <div style="display: grid; gap: 8px">
        <h2 id="h-notes">Technical Notes</h2>
        <p>Longer written notes for readers who want the detail: the maths, the code and the sources.</p>
      </div>
      <a href="/notes/" class="label" style="min-height: 44px; display: inline-flex; align-items: center">All technical notes →</a>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--frame-gutter)">
      {notes.map((n) => {
        const ep = episodeFor(n.data.episode);
        return (
          <Panel code={n.data.code} title={n.data.level} meta={`${n.data.mins} min read`}>
            <div style="display: flex; flex-direction: column; gap: 12px">
              <h3 class="h3-caps" style="margin: 0"><a href={`/notes/${n.id}/`} data-hl class="title-link">{n.data.title}</a></h3>
              <p style="margin: 0; font: var(--text-body); color: var(--ink-2); text-wrap: pretty">{n.data.summary}</p>
              <span class="label" style="color: var(--ink-3); border-top: var(--rule-fine) solid var(--paper-3); padding-top: 10px; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center">
                {ep ? <a href={`/episodes/${ep.id}/`}>Goes with {n.data.episode} →</a> : <span>Goes with {n.data.episode} (coming soon)</span>}
                <span>// Placeholder post</span>
              </span>
            </div>
          </Panel>
        );
      })}
    </div>
  </section>

  <section id="how-we-check" aria-labelledby="h-check" data-wipe class="section">
    <div class="section-head" style="display: flex; flex-wrap: wrap; align-items: center; gap: 24px 32px">
      <ResponsiveStamp client:load kind="ok" />
      <div style="flex: 1 1 320px; display: grid; gap: 8px">
        <h2 id="h-check">How we check</h2>
        <p>Every video is checked and sourced. You can see the working.</p>
      </div>
    </div>
    <ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px var(--frame-gutter)">
      {[
        ['A source for every claim', 'Each episode page has a public list of its claims, with a source for each one.'],
        ['Model behaviour is dated', 'Anything about how a model behaves names the model and the date we checked it. Models change.'],
        ['Mistakes are corrected openly', 'Corrections are logged and dated on the episode page.'],
      ].map(([h, p], i) => (
        <li style="display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: var(--rule-fine) solid var(--ink-1)">
          <strong class="h3-caps">{h}</strong>
          <p style="margin: 0; font: var(--text-body); color: var(--ink-2); text-wrap: pretty">{p}{i === 2 && <> <a href={`/episodes/${ep1.id}/#claims`}>See an example →</a></>}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="follow" aria-labelledby="h-follow" data-wipe class="section">
    <div class="section-head" style="margin-bottom: 24px"><h2 id="h-follow">Follow</h2></div>
    <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 48px; font: var(--weight-medium) var(--type-body-l)/1.3 var(--font-body)">
      <li><a href={site.youtube} style="min-height: 44px; display: inline-flex; align-items: center; gap: 10px"><span style="font-family: var(--font-mono)">▶</span>YouTube — @standardinference</a></li>
      <li><a href="#" style="min-height: 44px; display: inline-flex; align-items: center; gap: 10px"><span style="font-family: var(--font-mono)">→</span>TikTok — [handle placeholder]</a></li>
      <li><a href="#" style="min-height: 44px; display: inline-flex; align-items: center; gap: 10px"><span style="font-family: var(--font-mono)">→</span>Instagram — [handle placeholder]</a></li>
    </ul>
  </section>
</Base>
